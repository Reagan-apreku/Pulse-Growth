# --- MongoDB ----------------------------------------------------------------
# Set this to connect to a real MongoDB database. Leave unset to use the
# built-in local JSON data store (zero setup, great for demos and dev).
# Example: mongodb+srv://user:pass@cluster.mongodb.net/pulse
MONGODB_URI=

# --- Paystack ---------------------------------------------------------------
# Get your keys from https://dashboard.paystack.com → Settings → API Keys.
# Use test keys for development, live keys for production.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- App URL ----------------------------------------------------------------
# Base URL for redirect callbacks. In production, set this to your domain.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Admin login -------------------------------------------------------------
# Defaults to admin@pulse.dev / pulse-admin if unset. Change before deploying.
# Access the admin panel by navigating to /admin in your browser.
ADMIN_EMAIL=admin@pulse.dev
ADMIN_PASSWORD=pulse-admin

# Secret used to sign the admin session cookie. Set this to a long random
# string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# --- WhatsApp (customer-facing) -----------------------------------------------
# Number customers land on when they tap "Chat on WhatsApp", in international
# format with no + or spaces, e.g. 233551234567.
NEXT_PUBLIC_WHATSAPP_NUMBER=233000000000

# --- WhatsApp Admin Alerts ---------------------------------------------------
# Get notified on WhatsApp when a new paid order comes in.
# Get your free API key at https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_API_KEY=

# --- Automated WhatsApp Bot (UltraMsg API) -----------------------------------
# Send automated WhatsApp messages directly to resellers upon approval.
# Get instance credentials at https://ultramsg.com
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

